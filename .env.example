# local dev: cp .env.example .env
DATABASE_URL=postgresql+asyncpg://planner:planner@localhost:5432/planner
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
CLAUDE_EFFORT=medium
TIMEZONE=Europe/Berlin
# long random value: python -c "import secrets; print(secrets.token_urlsafe(32))"
ICS_FEED_TOKEN=
# only if the web app runs on another origin (comma separated)
CORS_ORIGINS=
SCHEDULER_ENABLED=true
ICS_SYNC_MINUTES=15

# --- prod (docker-compose.prod.yml) ---
# DATABASE_URL above is set by compose in prod (from POSTGRES_PASSWORD)
# placeholders only, real values live in the .env on the server

# long random password: python -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_PASSWORD=
# cloudflare tunnel token (zero trust -> networks -> tunnels)
CLOUDFLARE_TUNNEL_TOKEN=
# server lan ip the app port binds to (empty = 127.0.0.1 only)
LAN_IP=
APP_PORT=8080
# where db backups go on the server
BACKUP_DIR=./backups
# hour (0-23, TIMEZONE) and retention in days
BACKUP_HOUR=3
BACKUP_KEEP_DAYS=14
